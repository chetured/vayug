---
import Logo from "./Logo.astro";
import { site, url, hasSampleData } from "../lib/data.js";
const links = [
  ["Open weeks", "/open-weeks/"],
  ["Find a yacht", "/yachts/"],
  ["Destinations", "/destinations/"],
  ["About", "/about/"],
];
---
{hasSampleData && (
  <div class="demo-banner">Preview site: the yachts and prices shown are sample data, not real offers. Live availability is switched on once our booking-system accounts are approved.</div>
)}
<header class="site-header">
  <nav class="container nav" aria-label="Main">
    <a class="brand" href={url("/")}><Logo /> {site.name}</a>
    <button class="menu-toggle" aria-label="Menu" aria-expanded="false" id="menu-toggle">&#9776;</button>
    <div class="nav-links" id="nav-links">
      {links.map(([label, href]) => <a href={url(href)}>{label}</a>)}
      <a class="btn btn-primary" href={url("/contact/")}>Plan my charter</a>
    </div>
  </nav>
</header>
<script>
  const toggle = document.getElementById("menu-toggle");
  const links = document.getElementById("nav-links");
  toggle?.addEventListener("click", () => {
    const open = links?.classList.toggle("open");
    toggle.setAttribute("aria-expanded", String(open));
  });
</script>
