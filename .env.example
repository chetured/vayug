# Copy to .env for local use. In GitHub, add these under
# Settings > Secrets and variables > Actions.

# --- Booking systems (fill in once your agency accounts are approved) ---
NAUSYS_USERNAME=
NAUSYS_PASSWORD=
BOOKING_MANAGER_API_KEY=
# Sedna has no public API docs yet; ask Sedna for agency API access.

# Which sources to sync, comma separated: sample, nausys, bookingmanager
AVAILABILITY_SOURCES=sample

# --- AI content (Claude API key from platform.claude.com) ---
ANTHROPIC_API_KEY=

# --- Website (public values, safe to expose) ---
# Form backend URL, for example a Formspree form: https://formspree.io/f/xxxxxxx
PUBLIC_FORM_ENDPOINT=
# Google Analytics 4 measurement ID, for example G-XXXXXXX
PUBLIC_GA_ID=

# --- Deployment ---
# Leave empty for vayug.com. For the GitHub Pages preview use:
# SITE_URL=https://chetured.github.io  BASE_PATH=/<repo-name>
SITE_URL=
BASE_PATH=
